# System Ports and URLs
GATEWAY_URL=http://localhost:8001
MARKET_URL=http://localhost:8002
AGENT_URL=http://localhost:8003

# Next.js Web App URLs
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8001
NEXT_PUBLIC_MARKET_URL=http://localhost:8002
NEXT_PUBLIC_AGENT_URL=http://localhost:8003

# Databases
GATEWAY_DATABASE_URL=postgresql://trustrail:trustrail@localhost:5432/gateway_db
MARKET_DATABASE_URL=postgresql://trustrail:trustrail@localhost:5432/market_db

# Demo Mode & Security
DEMO_MODE=true

# LLM Keys (Groq / OpenAI / Anthropic)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
